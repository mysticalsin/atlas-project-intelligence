flowchart TD
 A["1. Identify consultant and project"] --> B["2. Prefill authorized context"]
 B --> C["3. MiChat voice or text interview"]
 C --> D["4. Adaptive follow-up and challenge"]
 D --> E["5. Project and individual contribution evidence"]
 E --> F["6. Attach artifacts, metrics, sources and attribution"]
 F --> G["7. Manager or project owner factual review"]
 G --> H{"Accepted?"}
 H -- "No" --> I["Clarify, correct or dispute"] --> C
 H -- "Yes" --> J["Approve evidence revision"]
 J --> K["Purpose-specific projections"]
 K --> K1["DNA skills update"]
 K --> K2["MeChat CV"]
 K --> K3["IMP capability signal"]
 J --> M["MAAP Review when due or triggered"]
 J --> P["Project Review: alignment, quality and readiness"]
 J --> S["Spotlight story candidate"]
 S --> T["Fact, customer, confidentiality and publication approvals"]
 T --> U{"Public release authorized?"}
 U -- "No" --> V["Hold, revise or internal-only"]
 U -- "Yes" --> W["Publish approved Spotlight version"]
