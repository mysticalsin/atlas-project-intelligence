{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
  "manifestVersion": "1.30",
  "version": "1.0.0",
  "id": "{{TEAMS_APP_ID}}",
  "developer": {
    "name": "{{TEAMS_DEVELOPER_NAME}}",
    "websiteUrl": "{{TEAMS_DEVELOPER_WEBSITE_URL}}",
    "privacyUrl": "{{TEAMS_PRIVACY_URL}}",
    "termsOfUseUrl": "{{TEAMS_TERMS_URL}}"
  },
  "name": {
    "short": "ATLAS",
    "full": "ATLAS project intelligence"
  },
  "description": {
    "short": "Short voice interviews that turn finished projects into references.",
    "full": "ATLAS asks consultants for a short voice interview when a project ends, so the work becomes a reusable, reviewed project reference. This Teams app only brings the invitation to you: the interview itself opens in your browser, signed in as you. ATLAS sends a card only after a reviewer approves it, and it stops when you type stop."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#3E007A",
  "staticTabs": [
    {
      "entityId": "atlas",
      "name": "ATLAS",
      "contentUrl": "https://{{ATLAS_HOST}}/teams/tab",
      "websiteUrl": "https://{{ATLAS_HOST}}/",
      "scopes": ["personal"]
    },
    {
      "entityId": "conversations",
      "scopes": ["personal"]
    }
  ],
  "bots": [
    {
      "botId": "{{TEAMS_BOT_APP_ID}}",
      "scopes": ["personal"],
      "isNotificationOnly": false,
      "supportsFiles": false,
      "supportsCalling": false,
      "supportsVideo": false,
      "commandLists": [
        {
          "scopes": ["personal"],
          "commands": [
            { "title": "stop", "description": "Stop interview invitations" }
          ]
        }
      ]
    }
  ],
  "validDomains": ["{{ATLAS_HOST}}"]
}
