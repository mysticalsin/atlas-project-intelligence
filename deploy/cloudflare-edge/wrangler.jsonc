// ATLAS edge test deployment. Deploy with ./deploy.sh (runs the tests first).
{
  "name": "atlas",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "INTERVIEW", "class_name": "Interview" }, { "name": "LIBRARY", "class_name": "LibraryStore" }, { "name": "SPEND_LEDGER", "class_name": "ProductionSpendLedger" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Interview"] }, { "tag": "v2", "new_sqlite_classes": ["LibraryStore"] }, { "tag": "v3", "new_sqlite_classes": ["ProductionSpendLedger"] }],
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "observability": { "enabled": true },
  "triggers": { "crons": ["17 6 * * *"] },
  "vars": {
    "ORIGIN": "https://atlas.tony-walteur.workers.dev",
    "ACCESS_TEAM_DOMAIN": "tony-walteur.cloudflareaccess.com",
    "ACCESS_AUD": "fc05e3d966db92b03ed3bf38b31e5c5254e1508bb0e090825a56ce12a933f386",
    "STT_MODEL": "@cf/deepgram/nova-3",
    "TTS_MODEL": "@cf/deepgram/aura-2-en",
    "TTS_VOICE": "harmonia",
    "TALKER_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "ANALYST_MODEL": "@cf/openai/gpt-oss-120b",
    "REVIEWER_EMAILS": "",
    // ATLAS_ADMIN_ROLES, ATLAS_ADMIN_SUBJECTS, ATLAS_PRESALES_ROLES and ATLAS_REVIEWER_ROLES are intentionally
    // absent. A missing value grants nobody. Set them on the approved deployment before anyone is elevated.
    // ATLAS_TENANT_ISOLATION is absent, so tenant checks fail closed. Do not set local-synthetic or ATLAS_DEV_IDENTITY here.
    // ATLAS_SYSTEM_TENANT is intentionally absent. Do not put a tenant id, a grant, or a secret in this file.
    // IDENTITY_SOURCE=entra is set on the deployment, not here. When isolation is on and this value is missing:
    // POST /api/triggers, POST /api/directory/push, and POST /api/teams/messages return HTTP 503.
    // The daily cron in app.js scheduled() returns without calling the library. It has no HTTP response, so it does not return 503.
    // None of these paths take a tenant from the request.
    "READY_SCORE": "75",
    "EMBED_MODEL": "@cf/baai/bge-m3",
    "STT_LANGUAGE": "multi",
    "TTS_MODEL_ES": "@cf/deepgram/aura-2-es",
    "TTS_VOICE_ES": "celeste",
    "ELEVENLABS_MODEL": "eleven_flash_v2_5",
    "ELEVENLABS_VOICE_ID": "21m00Tcm4TlvDq8ikWAM",
    // Tony, 2026-11-11, via Jarvis 18:19 BRT: every AI call shares one $5 UTC-month budget and fails closed.
    // No limit override in this file, so the $5 default in meter.js applies.
    "LEDGER_MODE": "enforce"
  }
  // Secrets (never committed): CSRF_SECRET (deploy.sh); optional via set-keys.sh: HINDSIGHT_API_KEY, TYPESAFE_API_KEY, ELEVENLABS_API_KEY
  // Optional WOW vars (docs/WOW_SPEC.md section 5), all unset by default; Tony decides and sets them, no values here:
  // EXTERNAL_EMAILS (exact confirmer emails, comma-separated), CLIENT_CONFIRM (1)
  // Zero-setup vars (docs/WOW_ZERO_CONFIG.md sections 4 and 5), all unset by default, no values here:
  // DATA_MODE (production; only on an approved Mantu deployment: removes the test banner, allows real DNA/HR data)
  // DNA pull, ASSUMED shape, from Mantu IT: DNA_PROFILE_URL (https template with one {email} or {oid}), DNA_AUTH_HEADER (default Authorization), DNA_FIELD_MAP (JSON); secret DNA_API_KEY
  // DNA push: secret DIRECTORY_PUSH_SECRET, plus an Access bypass on /api/directory/push only (Tony)
  // Teams (connected once all are set; no on switch): TEAMS_APP_ID, TEAMS_TENANT_ID; secret TEAMS_BOT_SECRET (wrangler secret put, by Tony); TEAMS_BOT_APP_ID only if the bot has its own app id (defaults to TEAMS_APP_ID)
  // TEAMS_SERVICE_HOSTS (optional, comma-separated host names added to the Teams connector allow-list beyond smba.trafficmanager.net)
}
