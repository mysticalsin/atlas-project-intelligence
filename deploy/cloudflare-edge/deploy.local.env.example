# Copy to deploy.local.env in this directory. That copy is gitignored.
# bash deploy/cloudflare-edge/deploy.sh reads it when the variables are not already set.
# The three values below are the committed placeholders. Replace them with the live
# origin, the Access team hostname, and the 64-character Access audience tag.
# deploy.sh refuses these placeholders and does not call wrangler.
ATLAS_ORIGIN=https://atlas.example.test
ATLAS_ACCESS_TEAM_DOMAIN=team.example.test
ATLAS_ACCESS_AUD=replace-me
