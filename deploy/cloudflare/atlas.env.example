# SERVER ONLY — ATLAS behind Cloudflare Tunnel + Access. Copy to .env on the gateway host,
# chmod 600, never commit. Cloudflare Access is an outer gate; Entra remains the app identity
# (per-user Hindsight banks and non-author review depend on distinct tid+oid subjects).
# Selected route (2026-09-26): Kyutai STT/TTS on a private GPU + conversation LLM + evidence analyst.
# See docs/KYUTAI_SETUP.md. Private speech services only; never expose their ports publicly.
ATLAS_VOICE_PROVIDER=kyutai
KYUTAI_STT_URL=wss://stt.internal.example.com
KYUTAI_TTS_URL=wss://tts.internal.example.com
KYUTAI_API_KEY=
# Commercially licensed voice only (voice-donations/, voice-zero/, vctk/, alba-mackenna/). expresso/ and ears/ are refused.
KYUTAI_VOICE=
CONVERSATION_CHAT_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1/chat/completions
# Selected after the 2026-09-26 Workers AI check (handoff/verification/workers-ai-2026-09-26):
CONVERSATION_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CONVERSATION_API_KEY=

# Alternative: hosted OpenAI Realtime (per-minute billing). Set ATLAS_VOICE_PROVIDER=openai and:
# OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# OPENAI_REALTIME_VOICE=cedar
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

ATLAS_AUTH=entra
ATLAS_BIND=127.0.0.1
ATLAS_PORT=8080
# Exact public hostname routed by cloudflared; no port, no path, must equal httpHostHeader.
ATLAS_ORIGIN=https://atlas.example.com
ATLAS_MAX_SECONDS=900
# Concurrent interviews (one per user). Worst-case hosted spend = slots x session length; load-test before raising.
ATLAS_MAX_INTERVIEWS=20
# Signed-in sessions per process (1 hour each); size from campaign peak sign-ins per hour.
ATLAS_MAX_SESSIONS=3000
ATLAS_HANDSHAKE_TIMEOUT=90
# Private durable path on the gateway host (not OneDrive, not a container layer). Back up with its SQLite registry.
ATLAS_WIKI_ROOT=/var/lib/atlas/wiki

ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REQUIRED_ROLE=ATLAS.Interview

# Optional private continuity (pinned mysticalsin/hindsight fork, see docs/SOURCE_LOCK.json).
# HINDSIGHT_URL=https://your-private-hindsight
# HINDSIGHT_API_KEY=
# HINDSIGHT_BANK_SECRET=

# Analyst brain (live evidence), OpenAI-compatible tool-calling endpoint, e.g. Workers AI:
ANALYST_CHAT_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1/chat/completions
ANALYST_MODEL=@cf/openai/gpt-oss-120b
ANALYST_API_KEY=

# Optional: STORY_EDITOR_MODEL=, TYPESAFE_API_KEY=, JEV_MODEL=jev-1.13.0
