# SERVER ONLY. Copy to .env; never commit it or expose it to the browser.
# Select one provider; changing it requires an explicit server restart.
ATLAS_VOICE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=cedar
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
ATLAS_WIKI_ROOT=./data/wiki
# Optional source-grounded editorial pass. Use an approved structured-output model.
# STORY_EDITOR_MODEL=

# Alternative selected-for-scale route: ATLAS_VOICE_PROVIDER=kyutai (docs/KYUTAI_SETUP.md)
# KYUTAI_STT_URL= / KYUTAI_TTS_URL= / KYUTAI_API_KEY= / KYUTAI_VOICE=
# CONVERSATION_CHAT_URL= / CONVERSATION_MODEL= / CONVERSATION_API_KEY=
# ANALYST_CHAT_URL= / ANALYST_MODEL= / ANALYST_API_KEY=

# Optional genuine TypeSafe decision API:
# TYPESAFE_API_KEY=
# JEV_MODEL=jev-1.13.0

ATLAS_AUTH=local
ATLAS_BIND=127.0.0.1
# VibeApps manifest port. The process listens here. Default in code is 8080.
ATLAS_PORT=8080
ATLAS_ORIGIN=http://localhost:8080
# VibeApps only. Leave unset for local and Entra. ATLAS_AUTH=vibeapps requires one prefix.
# APP_BASE_PATH=/run/atlas/
# APP_BASE_PATH=/run/atlas-dev/
PERSONAPLEX_WS_URL=ws://127.0.0.1:8998/api/chat
PERSONAPLEX_VOICE=NATM1.pt
ATLAS_MAX_SECONDS=900
ATLAS_MAX_INTERVIEWS=1
ATLAS_HANDSHAKE_TIMEOUT=90
FFMPEG=ffmpeg

# For a shared HTTPS deployment, set ATLAS_AUTH=entra and an exact HTTPS origin.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REQUIRED_ROLE=ATLAS.Interview

# Per authenticated tenant and object identity. Keep the secret stable across restarts.
# Values are Key Vault secrets (hindsight-api-key, hindsight-bank-secret). They are not written here.
# HINDSIGHT_URL=
# HINDSIGHT_API_KEY=
# HINDSIGHT_BANK_SECRET=

# Optional separate NVIDIA ASR route for consultant notes after the voice session.
# RIVA_URI=your-approved-riva-host:443
# RIVA_SSL=true
# RIVA_API_KEY=
# RIVA_FUNCTION_ID=
# RIVA_MODEL=

# Optional exact-excerpt topic assignment. Specify the FULL chat completions URL
# of your authorized endpoint and its actual model name; no endpoint is invented.
# NOTES_CHAT_URL=https://your-approved-service/v1/chat/completions
# NOTES_MODEL=
# NOTES_API_KEY=

# Additional Entra app roles, assigned to independent people for wiki review:
# ATLAS.Review = factual/source review; ATLAS.Publish = exact-audience authorization.
# All users also need the configured ATLAS.Interview role.
