# Secrets and local credentials (the sanitized example stays versioned)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
# Runtime customer data and locally generated exports
/data/
/vault/
/knowledge-vault/
/exports/
/backups/
*.sqlite
*.sqlite3
*.sqlite3-*
*.db
# Local environments and generated caches
.venv*/
__pycache__/
.pytest_cache/
*.pyc
*.log
.DS_Store
# Fresh test artifacts; received verification evidence is intentionally packaged.
/tests/last-local-story.md
/tests/run-local/
/handoff/verification/local-*/
/tests/report-screens/

# Browser automation snapshots can contain on-screen secrets
.playwright-mcp/
*.key

# Local Claude Code state
.claude/
# Keep the received verification evidence logs
!handoff/verification/*.log

# Tooling caches
node_modules/
.wrangler/
.npm/
# Operator deploy values. The example stays versioned. The temp wrangler file is written at deploy time.
deploy/cloudflare-edge/deploy.local.env
deploy/cloudflare-edge/deploy.wrangler.*.json
